rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Limitação real e documentada do Firebase: regras de Storage só conseguem consultar
    // o banco Firestore "(default)" via firestore.get() — não alcançam bancos com nome
    // próprio como o desta clínica. Isso significa que a versão anterior desta função
    // (que tentava ler system/authorized_admins do Firestore) NUNCA funcionava de
    // verdade — falhava silenciosamente, sem erro visível. Por isso os e-mails dos
    // administradores estão fixos aqui diretamente.
    //
    // Atenção: se um novo administrador for adicionado pelo painel do app no futuro,
    // ele terá acesso normal ao Firestore, mas NÃO vai conseguir ver fotos/arquivos
    // enviados por outros administradores até o e-mail dele também ser adicionado aqui
    // manualmente e as regras republicadas.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in
        ['contato.dravitoriaoliveira@gmail.com', 'thifcms@gmail.com', 'thifcms@bol.com.br'];
    }

    // Fotos e arquivos de pacientes ficam em: patients/{uid}/{patientId}/...
    // {uid} aqui é só quem originalmente enviou o arquivo (histórico), não quem pode
    // acessar — isso quem decide é isAdmin() abaixo.
    match /patients/{uid}/{allPaths=**} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Backups automáticos em PDF (gerados sozinhos quando uma anamnese/evolução é
    // liberada) — só administrador acessa, mesmo que qualquer usuário autorizado possa
    // ter sido quem gerou o arquivo.
    match /backups/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Assinatura do profissional (cadastrada uma vez em Configurações → Perfil, usada
    // automaticamente em documentos liberados). Mesmo padrão de settings no Firestore:
    // qualquer usuário autorizado lê (precisa pra gerar documentos), só admin escreve.
    match /signatures/{ownerId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Qualquer outro caminho: negado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
