rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Administradores — acesso total a todos os prontuários/agenda/financeiro, guardados
    // em system/authorized_admins.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in
           get(/databases/$(database)/documents/system/authorized_admins).data.emails;
    }

    // Usuários comuns — podem entrar no sistema, mas só enxergam os próprios pacientes
    // (guardados em system/authorized_staff).
    function isAuthorizedStaff() {
      return isSignedIn()
        && request.auth.token.email in
           get(/databases/$(database)/documents/system/authorized_staff).data.emails;
    }

    // Pra saber só "essa pessoa pode entrar no sistema" (não decide o nível de acesso aos
    // dados, só se consegue passar da tela de login)
    function isAuthorizedToLogIn() {
      return isAdmin() || isAuthorizedStaff();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner() {
      return isSignedIn() && isAuthorizedToLogIn() && incoming().userId == request.auth.uid;
    }

    function ownsExisting() {
      return isSignedIn() && isAuthorizedToLogIn() && resource.data.userId == request.auth.uid;
    }

    // Acesso aos dados clínicos (pacientes, agendamentos, financeiro, estoque):
    // administrador vê/edita tudo; usuário comum só o que ele mesmo criou.
    function isSharedAccess() {
      return isAdmin();
    }

    // Financeiro é visível/editável só por esses dois e-mails especificamente — mais
    // restrito que "administrador" comum, já que a lista de admins pode crescer no futuro
    // sem que isso implique acesso a dado financeiro da clínica.
    function isFinanceAuthorized() {
      return isSignedIn() && request.auth.token.email in
        ['contato.dravitoriaoliveira@gmail.com', 'thifcms@gmail.com'];
    }

    function isOwnDataAccess() {
      return isAuthorizedStaff() && resource.data.userId == request.auth.uid;
    }

    function isOwnDataCreate() {
      return isAuthorizedStaff() && incoming().userId == request.auth.uid;
    }

    // Patient Validation — só o formato dos dados, independente de quem está criando
    // (quem pode criar de fato é decidido separadamente nas regras de create/update abaixo —
    // mesmo padrão usado em appointments)
    function isValidPatient(data) {
      return data.userId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('email' in data) || data.email is string)
        && (!('phone' in data) || data.phone is string)
        && (!('birthDate' in data) || data.birthDate is string)
        && (!('address' in data) || data.address is string)
        && (!('cpf' in data) || data.cpf is string)
        && (!('sex' in data) || (data.sex is string && (data.sex == 'F' || data.sex == 'M')))
        && (!('faceMarkings' in data) || data.faceMarkings is list)
        && (!('photoHistory' in data) || data.photoHistory is list)
        && (!('files' in data) || data.files is list)
        && (!('evolution' in data) || data.evolution is list)
        && (!('exams' in data) || data.exams is list)
        && (!('anamnesis' in data) || data.anamnesis is map);
    }

    // Uma lista "anexo apenas" — o novo valor precisa conter TODOS os itens antigos,
    // exatamente como estavam, na mesma ordem, só permitindo adicionar itens novos no
    // final. Usado pra travar de vez o histórico de anamnese/evolução liberados: mesmo
    // um administrador não consegue mais editar ou apagar o que já foi liberado.
    function isAppendOnly(existingList, incomingList) {
      return incomingList.size() >= existingList.size()
        && (existingList.size() == 0 || incomingList[0:existingList.size()] == existingList);
    }

    // Garante que nenhuma anamnese/evolução liberada seja alterada — nem por
    // administrador. Aplica-se em toda atualização de paciente.
    function respectsClinicalLocks() {
      let existingAnamnesisHistory = ('anamnesisHistory' in resource.data) ? resource.data.anamnesisHistory : [];
      let incomingAnamnesisHistory = ('anamnesisHistory' in incoming()) ? incoming().anamnesisHistory : [];
      let existingEvolutionHistory = ('evolutionHistory' in resource.data) ? resource.data.evolutionHistory : [];
      let incomingEvolutionHistory = ('evolutionHistory' in incoming()) ? incoming().evolutionHistory : [];
      let anamnesisWasReleased = ('anamnesisReleased' in resource.data) && resource.data.anamnesisReleased == true;
      return isAppendOnly(existingAnamnesisHistory, incomingAnamnesisHistory)
        && isAppendOnly(existingEvolutionHistory, incomingEvolutionHistory)
        // Depois de liberada, o conteúdo da anamnese atual não pode mais mudar, e não dá
        // pra "desliberar" (voltar anamnesisReleased pra false)
        && (!anamnesisWasReleased || (
          incoming().anamnesis == resource.data.anamnesis
          && incoming().anamnesisReleased == true
        ));
    }

    // Appointment Validation — formato do documento, independente de quem está criando
    function isValidAppointmentShape(data) {
      return data.userId is string
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 200
        && data.date is string
        && data.time is string
        && (!('patientId' in data) || (data.patientId is string && isValidId(data.patientId)))
        && (!('guestPhone' in data) || (data.guestPhone is string && data.guestPhone.size() <= 30))
        && (!('status' in data) || data.status in ['scheduled', 'confirmed', 'completed', 'cancelled']);
    }

    // Criação normal, pelo dono autenticado (uso interno do app)
    function isOwnedAppointmentCreate(data) {
      return isSignedIn() && isAuthorizedToLogIn() && data.userId == request.auth.uid;
    }

    // Criação pública, pelo próprio paciente na página de agendamento (#agendar), sem login.
    // Só é permitida se o userId apontar pro dono real (validado contra publicConfig/booking),
    // o agendamento nascer como "scheduled" e vier marcado como bookedOnline — impede que alguém
    // crie agendamentos com outros status ou em nome de outra clínica.
    function isPublicAppointmentCreate(data) {
      return !isSignedIn()
        && data.userId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && data.status == 'scheduled'
        && data.bookedOnline == true;
    }

    // Check-in público, pelo próprio paciente na página #checkin, sem login. Não precisa LER
    // o agendamento (só escreve "às cegas"): a prova de que é o paciente certo é conhecer o
    // token secreto, que só existe no link que ele recebeu. affectedKeys().hasOnly garante que
    // essa escrita NUNCA consegue alterar mais nada além do horário de chegada — nem o próprio
    // token, nem status, nem valor, nem qualquer outro campo do agendamento.
    function isPublicCheckIn(data) {
      return !isSignedIn()
        && resource.data.checkinToken is string
        && data.checkinToken == resource.data.checkinToken
        && data.checkedInAt is string
        && data.diff(resource.data).affectedKeys().hasOnly(['checkedInAt']);
    }

    // Cancelamento público, pelo próprio paciente na página #cancelar, sem login — mesma
    // lógica do check-in (token secreto, affectedKeys().hasOnly trava que só o status pode
    // mudar). Só permite ir para 'cancelled', nunca reabrir ou mudar pra qualquer outro status.
    function isPublicCancel(data) {
      return !isSignedIn()
        && resource.data.checkinToken is string
        && data.checkinToken == resource.data.checkinToken
        && data.status == 'cancelled'
        && data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Inventory Validation
    function isValidInventory(data) {
      return data.userId is string
        && data.name is string && data.name.size() > 0
        && data.quantity is number
        && data.minThreshold is number
        && (!('category' in data) || data.category is string);
    }

    // Inventory Movement Validation
    function isValidInventoryMovement(data) {
      return data.userId is string
        && data.itemId is string
        && data.quantity is number
        && data.type in ['consumption', 'restock']
        && data.date is string;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.userId is string
        && data.amount is number
        && data.type in ['income', 'expense']
        && data.date is timestamp;
    }

    // Busy Slot Validation — documento público minimalista (só data/hora), sem nenhum dado do
    // paciente. O campo opcional 'apt' guarda o id do agendamento correspondente — usado só
    // pra permitir liberar o horário automaticamente quando esse agendamento é cancelado
    // (ver regra de delete abaixo), nunca exposto como dado do paciente.
    function isValidBusySlot(data) {
      return data.clinicId is string
        && data.date is string
        && data.time is string
        && (!('apt' in data) || (data.apt is string && isValidId(data.apt)));
    }

    // Índice de telefone → paciente — coleção pública minimalista (só clinicId + patientId,
    // NENHUM nome/dado pessoal) que a página de agendamento usa pra reconhecer um paciente que
    // já tem cadastro, sem precisar pedir os dados de novo. Só permite CRIAR uma entrada nova
    // (nunca sobrescrever uma existente — mesmo princípio do busySlots, evita que alguém
    // "sequestre" o índice de um telefone já vinculado a outro paciente).
    function isValidPhoneIndexEntry(data) {
      return data.clinicId is string
        && data.patientId is string && isValidId(data.patientId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    // Criação pública de paciente, direto na página de agendamento (#agendar), sem login —
    // só permitida com o userId batendo com o dono real da clínica (mesma checagem usada nos
    // agendamentos públicos). Continua exigindo o mesmo formato de dado (isValidPatient).
    function isPublicPatientCreate(data) {
      return !isSignedIn()
        && data.userId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId;
    }

    // Atualização pública de paciente já existente, direto no agendamento (#agendar), sem
    // login — usada quando a pessoa confirma/corrige telefone, e-mail etc. na tela de
    // "bem-vindo de volta". Só mexe nos dados cadastrais básicos — tudo que é clínico
    // (anamnese, evolução, financeiro, arquivos) precisa continuar EXATAMENTE igual,
    // senão a atualização é negada.
    function isPublicPatientUpdate(data) {
      return !isSignedIn()
        && data.userId == resource.data.userId
        && data.userId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && data.get('cpf', null) == resource.data.get('cpf', null)
        && data.get('anamnesis', null) == resource.data.get('anamnesis', null)
        && data.get('anamnesisReleased', null) == resource.data.get('anamnesisReleased', null)
        && data.get('anamnesisReleasedAt', null) == resource.data.get('anamnesisReleasedAt', null)
        && data.get('anamnesisReleasedBy', null) == resource.data.get('anamnesisReleasedBy', null)
        && data.get('anamnesisHistory', null) == resource.data.get('anamnesisHistory', null)
        && data.get('evolution', null) == resource.data.get('evolution', null)
        && data.get('evolutionHistory', null) == resource.data.get('evolutionHistory', null)
        && data.get('faceMarkings', null) == resource.data.get('faceMarkings', null)
        && data.get('files', null) == resource.data.get('files', null)
        && data.get('exams', null) == resource.data.get('exams', null)
        && data.get('photoHistory', null) == resource.data.get('photoHistory', null)
        && data.get('consentTerms', null) == resource.data.get('consentTerms', null)
        && data.get('prescriptions', null) == resource.data.get('prescriptions', null);
    }

    // Rules for Patients — só o dono do dado (userId) pode ler; criar é permitido também
    // pela página pública de agendamento (ver isPublicPatientCreate)
    match /patients/{patientId} {
      allow read: if isSharedAccess() || isOwnDataAccess();
      allow create: if isValidPatient(incoming()) && isValidId(patientId)
        && (isSharedAccess() || isOwnDataCreate() || isPublicPatientCreate(incoming()));
      allow update: if isValidPatient(incoming()) && respectsClinicalLocks()
        && ((isSharedAccess() || isOwnDataAccess()) || isPublicPatientUpdate(incoming()));
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Rules for Appointments
    match /appointments/{appointmentId} {
      allow read: if isSharedAccess() || isOwnDataAccess();
      // Leitura pública, só de um documento específico por ID (nunca lista) — usada
      // depois do check-in pra saber qual paciente é, e mostrar a ficha clínica de
      // harmonização facial. Segura pelo mesmo motivo que signRequests: o ID é gerado
      // aleatoriamente pelo Firestore, ninguém adivinha o de outra pessoa.
      allow get: if true;
      allow create: if isValidAppointmentShape(incoming()) && isValidId(appointmentId)
        && (isSharedAccess() || isOwnDataCreate() || isPublicAppointmentCreate(incoming()));
      allow update: if ((isSharedAccess() || isOwnDataAccess()) && isValidAppointmentShape(incoming()))
        || isPublicCheckIn(incoming())
        || isPublicCancel(incoming());
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Pedido de assinatura remota de termo (link enviado por WhatsApp) — o ID do próprio
    // documento é o "segredo": ninguém consegue listar ou adivinhar o pedido de outro
    // paciente, só quem tem o link exato consegue ler ou assinar aquele documento
    // específico. affectedKeys().hasOnly trava que a assinatura pública só consiga mudar
    // status/data/imagem da assinatura — nunca o texto do termo, o paciente vinculado, ou
    // qualquer outro campo.
    function isValidSignRequest(data) {
      return data.patientId is string
        && data.templateTitle is string
        && data.templateContent is string
        && data.status in ['pending', 'signed'];
    }

    function isPublicSign(data) {
      return !isSignedIn()
        && resource.data.status == 'pending'
        && data.status == 'signed'
        && data.signedAt is string
        && data.signatureUrl is string
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt', 'signatureUrl']);
    }

    match /signRequests/{requestId} {
      allow get: if true;
      allow list: if isSharedAccess() || isOwnDataAccess();
      allow create: if (isSharedAccess() || isOwnDataCreate()) && isValidSignRequest(incoming());
      allow update: if ((isSharedAccess() || isOwnDataAccess()) && isValidSignRequest(incoming()))
        || isPublicSign(incoming());
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Ficha clínica preenchida pelo próprio paciente após o check-in, sem login — envio
    // público (o ID do documento é o próprio ID do agendamento, que só quem passou pelo
    // check-in daquele agendamento específico conhece). Uma vez enviada, só a clínica
    // consegue ler/apagar — o paciente nunca lê de volta o que enviou, e ninguém
    // consegue sobrescrever um envio já feito (create falha se o ID já existe).
    function isValidIntakeSubmission(data) {
      return data.patientId is string
        && data.patientName is string
        && data.ownerId is string
        && data.submittedAt is string
        && data.signatureUrl is string
        && data.mainComplaint is string;
    }

    match /intakeSubmissions/{submissionId} {
      allow get, list: if isSharedAccess() || isOwnDataAccess();
      allow create: if isValidIntakeSubmission(incoming()) && isValidId(submissionId);
      allow update: if (isSharedAccess() || isOwnDataAccess()) && isValidIntakeSubmission(incoming());
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Rules for Inventory
    match /inventory/{itemId} {
      allow read: if isSharedAccess() || isOwnDataAccess();
      allow create: if (isSharedAccess() || isOwnDataCreate()) && isValidInventory(incoming()) && isValidId(itemId);
      allow update: if (isSharedAccess() || isOwnDataAccess()) && isValidInventory(incoming());
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Rules for Inventory Movements
    match /inventory_movements/{movementId} {
      allow read: if isSharedAccess() || isOwnDataAccess();
      allow create: if (isSharedAccess() || isOwnDataCreate()) && isValidInventoryMovement(incoming()) && isValidId(movementId);
      allow update: if (isSharedAccess() || isOwnDataAccess()) && isValidInventoryMovement(incoming());
      allow delete: if isSharedAccess() || isOwnDataAccess();
    }

    // Rules for Transactions
    match /transactions/{transactionId} {
      // Ler o financeiro completo, editar valores ou apagar lançamentos continua restrito
      // aos 2 e-mails autorizados (dado sensível de faturamento da clínica). Já CRIAR um
      // lançamento é diferente — acontece como consequência natural do trabalho clínico
      // de qualquer usuário autorizado (concluir uma consulta na agenda, marcar um
      // procedimento na anamnese) e não expõe ninguém aos dados financeiros de outros
      // pacientes/lançamentos, então não precisa da mesma restrição.
      allow read: if isFinanceAuthorized();
      allow create: if (isSharedAccess() || isOwnDataCreate()) && isValidTransaction(incoming()) && isValidId(transactionId);
      allow update: if isFinanceAuthorized() && isValidTransaction(incoming());
      allow delete: if isFinanceAuthorized();
    }

    // Marca horários como ocupados — coleção pública (só clinicId/data/hora, ZERO dado de
    // paciente) que a página de agendamento usa pra saber quais horários esconder. Qualquer um
    // pode ler (é assim que o calendário público sabe o que está livre). A criação exige que o
    // clinicId bata com o dono real (autenticado) ou, no caso público, com o dono cadastrado em
    // publicConfig/booking — isso impede que alguém "reserve" horários em nome de outra clínica
    // ou envie lixo pra essa coleção. Ninguém pode "atualizar" um slot já existente (isso é o
    // que impede duas pessoas reservarem o mesmo horário ao mesmo tempo: a segunda tentativa
    // vira uma escrita sobre um documento que já existe, e cai na regra de update, sempre negada).
    match /busySlots/{slotId} {
      allow read: if true;
      allow create: if isValidBusySlot(incoming()) && isValidId(slotId)
        && incoming().clinicId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && (isAuthorizedToLogIn() || !isSignedIn());
      allow update: if false;
      // Liberar o horário: o dono sempre pode (ex: cancelou/excluiu pelo app). Sem login,
      // permitido em dois casos: (1) o slot referencia um agendamento (campo 'apt') que JÁ
      // ESTÁ cancelado — só acontece via cancelamento com token (isPublicCancel acima); ou
      // (2) esse agendamento nunca chegou a ser criado de verdade (o agendamento falhou no
      // meio do caminho, depois de reservar o horário mas antes de criar o registro) — nesse
      // caso não há nada pra proteger, e travar o horário pra sempre seria pior que liberar.
      allow delete: if isAuthorizedToLogIn()
        || (resource.data.apt is string
            && (
              !exists(/databases/$(database)/documents/appointments/$(resource.data.apt))
              || get(/databases/$(database)/documents/appointments/$(resource.data.apt)).data.status == 'cancelled'
            ));
    }

    // Configuração pública usada pela página de agendamento (nome da clínica)
    match /publicConfig/booking {
      allow read: if true; // Página pública precisa ler pra mostrar o nome da clínica
      allow write: if isAdmin(); // Só administrador altera a configuração pública da clínica
    }

    // Cada profissional tem agenda própria (horários, dias, bloqueios). Leitura pública —
    // a página de agendamento (#agendar) precisa ler sem login pra saber os horários
    // disponíveis de cada um. Escrita só por administrador, mesmo pra bloquear a agenda
    // de outro profissional que não seja ele mesmo — decisão explícita do dono da clínica.
    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Índice público telefone → paciente (ver isValidPhoneIndexEntry acima)
    match /patientPhoneIndex/{phoneKey} {
      allow read: if true;
      allow create: if isValidPhoneIndexEntry(incoming()) && isValidId(phoneKey)
        && incoming().clinicId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && (isAuthorizedToLogIn() || !isSignedIn());
      allow update: if false;
      allow delete: if isAuthorizedToLogIn();
    }

    // Índice público CPF → paciente — mesmo padrão do índice de telefone acima, mas usado
    // como identificador principal agora (ver CPF-first no fluxo de agendamento)
    match /patientCpfIndex/{cpfKey} {
      allow read: if true;
      allow create: if isValidId(cpfKey)
        && incoming().clinicId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && incoming().patientId is string
        && (isAuthorizedToLogIn() || !isSignedIn());
      allow update: if isValidId(cpfKey)
        && incoming().clinicId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && incoming().patientId is string
        && (isAuthorizedToLogIn() || !isSignedIn());
      allow delete: if isAuthorizedToLogIn();
    }

    // Configurações da clínica — documento único e compartilhado (settings/{ownerId}).
    // Qualquer pessoa autorizada pode ler (precisa pra saber horário de atendimento etc.),
    // mas só administrador pode alterar.
    match /settings/{uid} {
      allow read: if isAuthorizedToLogIn();
      allow write: if isAdmin();
    }

    // Lista de e-mails administradores. Leitura liberada pra qualquer pessoa logada (é o
    // que permite o app checar "posso entrar?" logo após o login do Google) — só
    // administrador pode alterar quem está nessa lista.
    match /system/authorized_admins {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lista de e-mails de usuários comuns (acesso só aos próprios pacientes). Mesmo padrão
    // de leitura/escrita da lista de administradores acima.
    match /system/authorized_staff {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Senha do painel de administração — uma por administrador (guardada por UID), pra
    // cada um poder ter a própria senha em vez de uma só compartilhada.
    match /admin_security/{uid} {
      allow read, write: if isSignedIn() && isAdmin() && uid == request.auth.uid;
    }
  }
}
