rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner() {
      return isSignedIn() && incoming().userId == request.auth.uid;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Patient Validation
    function isValidPatient(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('email' in data) || data.email is string)
        && (!('phone' in data) || data.phone is string)
        && (!('birthDate' in data) || data.birthDate is string)
        && (!('address' in data) || data.address is string)
        && (!('cpf' in data) || data.cpf is string)
        && (!('photoHistory' in data) || data.photoHistory is list)
        && (!('files' in data) || data.files is list)
        && (!('evolution' in data) || data.evolution is list)
        && (!('anamnesis' in data) || data.anamnesis is map);
    }

    // Appointment Validation — formato do documento, independente de quem está criando
    function isValidAppointmentShape(data) {
      return data.userId is string
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 200
        && data.date is string
        && data.time is string
        && (!('patientId' in data) || (data.patientId is string && isValidId(data.patientId)))
        && (!('guestPhone' in data) || (data.guestPhone is string && data.guestPhone.size() <= 30))
        && (!('status' in data) || data.status in ['scheduled', 'confirmed', 'completed', 'cancelled']);
    }

    // Criação normal, pelo dono autenticado (uso interno do app)
    function isOwnedAppointmentCreate(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    // Criação pública, pelo próprio paciente na página de agendamento (#agendar), sem login.
    // Só é permitida se o userId apontar pro dono real (validado contra publicConfig/booking),
    // o agendamento nascer como "scheduled" e vier marcado como bookedOnline — impede que alguém
    // crie agendamentos com outros status ou em nome de outra clínica.
    function isPublicAppointmentCreate(data) {
      return !isSignedIn()
        && data.userId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId
        && data.status == 'scheduled'
        && data.bookedOnline == true;
    }

    // Check-in público, pelo próprio paciente na página #checkin, sem login. Não precisa LER
    // o agendamento (só escreve "às cegas"): a prova de que é o paciente certo é conhecer o
    // token secreto, que só existe no link que ele recebeu. affectedKeys().hasOnly garante que
    // essa escrita NUNCA consegue alterar mais nada além do horário de chegada — nem o próprio
    // token, nem status, nem valor, nem qualquer outro campo do agendamento.
    function isPublicCheckIn(data) {
      return !isSignedIn()
        && resource.data.checkinToken is string
        && data.checkinToken == resource.data.checkinToken
        && data.checkedInAt is string
        && data.diff(resource.data).affectedKeys().hasOnly(['checkedInAt']);
    }

    // Inventory Validation
    function isValidInventory(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0
        && data.quantity is number
        && data.minThreshold is number
        && (!('category' in data) || data.category is string);
    }

    // Inventory Movement Validation
    function isValidInventoryMovement(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.itemId is string
        && data.quantity is number
        && data.type in ['consumption', 'restock']
        && data.date is string;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.amount is number
        && data.type in ['income', 'expense']
        && data.date is timestamp;
    }

    // Busy Slot Validation — documento público minimalista (só data/hora), sem nenhum dado do paciente
    function isValidBusySlot(data) {
      return data.clinicId is string
        && data.date is string
        && data.time is string;
    }

    // Rules for Patients — só o dono do dado (userId) pode ler/escrever
    match /patients/{patientId} {
      allow read: if ownsExisting();
      allow create: if isValidPatient(incoming()) && isValidId(patientId);
      allow update: if ownsExisting() && isValidPatient(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Appointments
    match /appointments/{appointmentId} {
      allow read: if ownsExisting();
      allow create: if isValidAppointmentShape(incoming()) && isValidId(appointmentId)
        && (isOwnedAppointmentCreate(incoming()) || isPublicAppointmentCreate(incoming()));
      allow update: if (ownsExisting() && isValidAppointmentShape(incoming()) && incoming().userId == resource.data.userId)
        || isPublicCheckIn(incoming());
      allow delete: if ownsExisting();
    }

    // Rules for Inventory
    match /inventory/{itemId} {
      allow read: if ownsExisting();
      allow create: if isValidInventory(incoming()) && isValidId(itemId);
      allow update: if ownsExisting() && isValidInventory(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Inventory Movements
    match /inventory_movements/{movementId} {
      allow read: if ownsExisting();
      allow create: if isValidInventoryMovement(incoming()) && isValidId(movementId);
      allow update: if ownsExisting() && isValidInventoryMovement(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Transactions
    match /transactions/{transactionId} {
      allow read: if ownsExisting();
      allow create: if isValidTransaction(incoming()) && isValidId(transactionId);
      allow update: if ownsExisting() && isValidTransaction(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Marca horários como ocupados — coleção pública (só clinicId/data/hora, ZERO dado de
    // paciente) que a página de agendamento usa pra saber quais horários esconder. Qualquer um
    // pode ler (é assim que o calendário público sabe o que está livre). A criação exige que o
    // clinicId bata com o dono real (autenticado) ou, no caso público, com o dono cadastrado em
    // publicConfig/booking — isso impede que alguém "reserve" horários em nome de outra clínica
    // ou envie lixo pra essa coleção. Ninguém pode "atualizar" um slot já existente (isso é o
    // que impede duas pessoas reservarem o mesmo horário ao mesmo tempo: a segunda tentativa
    // vira uma escrita sobre um documento que já existe, e cai na regra de update, sempre negada).
    match /busySlots/{slotId} {
      allow read: if true;
      allow create: if isValidBusySlot(incoming()) && isValidId(slotId)
        && (
          (isSignedIn() && incoming().clinicId == request.auth.uid) ||
          (!isSignedIn() && incoming().clinicId == get(/databases/$(database)/documents/publicConfig/booking).data.ownerId)
        );
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // Configuração pública usada pela página de agendamento (nome da clínica)
    match /publicConfig/booking {
      allow read: if true; // Página pública precisa ler pra mostrar o nome da clínica
      allow write: if isSignedIn(); // Apenas logados podem setar (em Settings.tsx)
    }

    // Rules for Settings — um documento por usuário (settings/{uid})
    match /settings/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }
  }
}
