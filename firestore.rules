rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isOwner() {
      return isSignedIn() && incoming().userId == request.auth.uid;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Patient Validation
    function isValidPatient(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('email' in data) || data.email is string)
        && (!('phone' in data) || data.phone is string)
        && (!('birthDate' in data) || data.birthDate is string)
        && (!('address' in data) || data.address is string)
        && (!('cpf' in data) || data.cpf is string)
        && (!('photoHistory' in data) || data.photoHistory is list)
        && (!('files' in data) || data.files is list)
        && (!('evolution' in data) || data.evolution is list)
        && (!('anamnesis' in data) || data.anamnesis is map);
    }

    // Appointment Validation
    function isValidAppointment(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.patientId is string && isValidId(data.patientId)
        && data.date is string
        && data.time is string
        && (!('status' in data) || data.status in ['scheduled', 'confirmed', 'completed', 'cancelled']);
    }

    // Inventory Validation
    function isValidInventory(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0
        && data.quantity is number
        && data.minThreshold is number
        && (!('category' in data) || data.category is string);
    }

    // Inventory Movement Validation
    function isValidInventoryMovement(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.itemId is string
        && data.quantity is number
        && data.type in ['consumption', 'restock']
        && data.date is string;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.amount is number
        && data.type in ['income', 'expense']
        && data.date is timestamp;
    }

    // Rules for Patients — só o dono do dado (userId) pode ler/escrever
    match /patients/{patientId} {
      allow read: if ownsExisting();
      allow create: if isValidPatient(incoming());
      allow update: if ownsExisting() && isValidPatient(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Appointments
    match /appointments/{appointmentId} {
      allow read: if ownsExisting();
      // Criar agendamento: o dono (clínica) pode criar livremente via Dashboard,
      // e o público pode criar via página #agendar (bookedOnline=true).
      allow create: if (isSignedIn() && incoming().userId == request.auth.uid) || 
                       (incoming().bookedOnline == true);
      
      // Update: 
      // 1. O dono da clínica pode alterar qualquer coisa.
      // 2. O paciente pode fazer check-in (setar checkedInAt) SE enviar o token correto.
      allow update: if (ownsExisting() && incoming().userId == resource.data.userId) ||
                       (incoming().checkinToken == resource.data.checkinToken && 
                        incoming().diff(resource.data).affectedKeys().hasOnly(['checkedInAt', 'checkinToken']));
      
      allow delete: if ownsExisting();
    }

    // Rules for Inventory
    match /inventory/{itemId} {
      allow read: if ownsExisting();
      allow create: if isValidInventory(incoming());
      allow update: if ownsExisting() && isValidInventory(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Inventory Movements
    match /inventoryMovements/{movementId} {
      allow read: if ownsExisting();
      allow create: if isValidInventoryMovement(incoming());
      allow update: if ownsExisting() && isValidInventoryMovement(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Rules for Transactions
    match /transactions/{transactionId} {
      allow read: if ownsExisting();
      allow create: if isValidTransaction(incoming());
      allow update: if ownsExisting() && isValidTransaction(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if ownsExisting();
    }

    // Marca horários como ocupados — coleção pública (sem dados sensíveis)
    match /busySlots/{slotId} {
      allow read: if true; // Aberto pra página de agendamento saber o que tá livre
      // Criação aberta: permite que qualquer um "reserve" o horário atômicamente.
      // O ID do documento é determinístico (clinic_data_hora), então a regra de 
      // 'update' falsa abaixo garante que ninguém sobrescreva uma reserva de outro.
      allow create: if true;
      allow update: if false; // Garante atomicidade da reserva (quem chegar primeiro leva)
      // Delete: só a própria clínica (dono do slot) pode liberar o horário manualmente
      allow delete: if isSignedIn() && resource.data.clinicId == request.auth.uid;
    }

    // Configuração pública usada pela página de agendamento (nome da clínica)
    match /publicConfig/booking {
      allow read: if true; // Página pública precisa ler pra mostrar o nome da clínica
      allow write: if isSignedIn(); // Apenas logados podem setar (em Settings.tsx)
    }

    // Rules for Settings — um documento por usuário (settings/{uid})
    match /settings/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }
  }
}
